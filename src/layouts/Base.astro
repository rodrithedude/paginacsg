---
import '../styles/global.css';

import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { routes, t, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  jsonLd?: boolean;
}
const { lang, page, title, description, jsonLd = false } = Astro.props;
const s = t(lang);
const siteUrl = Astro.site ?? new URL('https://csgconstructora.com');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const alternates =
  page === 'notFound'
    ? []
    : [
        { hreflang: 'es', href: new URL(routes[page].es, siteUrl).href },
        { hreflang: 'en', href: new URL(routes[page].en, siteUrl).href },
        { hreflang: 'x-default', href: new URL(routes[page].es, siteUrl).href },
      ];
const ogImage = new URL('/og.png', siteUrl).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.brand,
  legalName: site.legalName,
  alternateName: site.name,
  url: new URL('/', siteUrl).href,
  image: ogImage,
  logo: new URL('/apple-touch-icon.png', siteUrl).href,
  foundingDate: site.foundingDate,
  taxID: site.taxId,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.postalCode,
    addressCountry: site.address.countryCode,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  areaServed: { '@type': 'Country', name: 'Guatemala' },
  numberOfEmployees: { '@type': 'QuantitativeValue', minValue: site.stats.employees },
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es-GT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {page !== 'notFound' && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="theme-color" content="#FF8311" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/chakra-petch-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_GT' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'notFound' && <meta name="robots" content="noindex" />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(org)}></script>}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-page={page}>
    <!-- Logotipo CSG oficial, vectorizado (se reutiliza en encabezado, menú y pie) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="logo-csg" viewBox="0 0 170 53">
        <path d="M0 0H53V12H12V41H53V53H0Z" />
        <path d="M58 0H111V12H70V20H111V53H58V41H99V33H58Z" />
        <path d="M116 0H170V12H128V41H157V33H137V20H170V53H116Z" />
      </symbol>
    </svg>

    <a class="skip-link" href="#contenido">{s.skip}</a>
    <Menu lang={lang} page={page} />
    <div class="page">
      <main id="contenido">
        <slot />
      </main>
      <Footer lang={lang} page={page} />
    </div>

    <!-- Visor de fotos de proyectos -->
    <dialog class="lightbox" aria-label={s.lightbox.label} data-lightbox>
      <div class="lightbox__bar">
        <p class="lightbox__title" data-lb-title></p>
        <span class="label lightbox__count" data-lb-count></span>
        <button class="btn btn--orange" type="button" data-lb-close>
          {s.lightbox.close} <span class="menu__x" aria-hidden="true"></span>
        </button>
      </div>
      <figure class="lightbox__stage">
        <img data-lb-img alt="" />
      </figure>
      <button class="sq-btn lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label={s.lightbox.prev}>
        <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M14.5 8h-12M7 3.5 2.5 8 7 12.5" /></svg>
      </button>
      <button class="sq-btn lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label={s.lightbox.next}>
        <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1.5 8h12M9 3.5 13.5 8 9 12.5" /></svg>
      </button>
    </dialog>

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
