// Cloudflare Workers: publica el sitio estático que genera `npm run build` (carpeta dist/).
// El nombre debe coincidir con el del Worker en Cloudflare.
{
  "name": "paginacsg",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
