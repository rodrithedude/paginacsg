---
import { Image } from 'astro:assets';
import { logo } from '../lib/media';
import site from '../data/site.json';

interface Props {
  class?: string;
  /** Altura en px del logo cuando es una imagen subida (src/assets/logo.*). */
  height?: number;
  /** Logotipo completo: marca CSG + línea + razón social, como en el logo oficial. */
  lockup?: boolean;
}
const { class: cls = '', height = 80, lockup = false } = Astro.props;
---
{
  logo ? (
    <Image src={logo} alt="" height={height} loading="eager" class={`logo logo--img ${cls}`} />
  ) : lockup ? (
    <span class={`lockup ${cls}`}>
      <svg class="logo" viewBox="0 0 170 53" aria-hidden="true">
        <use href="#logo-csg" />
      </svg>
      <span class="lockup__rule" aria-hidden="true" />
      <span class="lockup__text" aria-hidden="true">
        {site.logoLines.map((line) => (
          <span>{line}</span>
        ))}
      </span>
    </span>
  ) : (
    <svg class={`logo ${cls}`} viewBox="0 0 170 53" aria-hidden="true">
      <use href="#logo-csg" />
    </svg>
  )
}
