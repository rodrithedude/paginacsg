---
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = '' } = Astro.props;

// Íconos de línea propios. "svc-*" (120×120) para servicios; el resto (16×16) para la interfaz.
const service: Record<string, string> = {
  // Control de márgenes fluviales: sección de río con bordas y espigones
  river:
    '<path d="M8 96h104"/><path d="M8 96 22 62h14l12 34M112 96 98 62H84L72 96"/><path d="M22 62v-8h14v8M84 62v-8h14v8"/><path d="M46 80c4 0 5-4 9-4s5 4 9 4 5-4 9-4M44 89c4 0 6-4 10-4s5 4 9 4 6-4 10-4"/><path d="M60 24v20M52 32l8-8 8 8"/>',
  // Obra civil: bodega con cercha y drenaje
  building:
    '<path d="M10 100h100"/><path d="M20 100V52l40-26 40 26v48"/><path d="M20 52h80M30 52l10-6.5M50 52 60 26M70 52 60 26M90 52l-10-6.5M40 45.5V52M80 45.5V52"/><rect x="46" y="72" width="28" height="28"/><path d="M60 72v28"/><circle cx="31" cy="86" r="5"/><circle cx="89" cy="86" r="5"/>',
  // Pavimentos: carretera en perspectiva con capas
  road:
    '<path d="M10 52h100"/><path d="M50 52 22 108M70 52l28 56"/><path d="M60 58v8M60 74v10M60 92v14"/><path d="M10 52 28 30l14 12 16-20 20 22 12-8 20 16"/>',
  // Movimientos de tierra: perfil de terreno con rasante de diseño
  earth:
    '<path d="M10 100h100"/><path d="M10 70 30 50l16 14 22-26 18 20 24-12"/><path d="M10 78h100" stroke-dasharray="4 4"/><path d="M30 50v28M46 64v14M68 38v40M86 58v20"/><path d="M14 100l6-10M30 100l6-10M46 100l6-10M62 100l6-10M78 100l6-10M94 100l6-10"/>',
  // Hidroeléctricas: presa en sección con embalse y turbina
  dam: '<path d="M10 100h100"/><path d="M48 100V28h12l22 72"/><path d="M14 44c4 0 6-4 10-4s6 4 10 4 6-4 10-4M14 56c4 0 6-4 10-4s6 4 10 4 6-4 10-4M14 68c4 0 6-4 10-4s6 4 10 4 6-4 10-4"/><circle cx="92" cy="40" r="12"/><path d="m94 30-6 11h8l-6 10"/>',
  // Planificación y dirección: ejes de replanteo con puntos de control
  plan: '<path d="M18 62h84M60 20v84"/><path d="M26 58v8M34 58v8M42 58v8M50 58v8M70 58v8M78 58v8M86 58v8M94 58v8M56 28h8M56 36h8M56 44h8M56 52h8M56 72h8M56 80h8M56 88h8M56 96h8"/><circle cx="38" cy="38" r="4.5"/><circle cx="83" cy="43" r="4.5"/><circle cx="43" cy="83" r="4.5"/><circle cx="90" cy="88" r="4.5"/>',
  // Urbanización: planta de lotificación con calles
  houses:
    '<rect x="14" y="14" width="92" height="92"/><path d="M14 56h92M14 64h92M56 14v42M64 64v42"/><rect x="22" y="22" width="12" height="12"/><rect x="38" y="22" width="12" height="12"/><rect x="70" y="22" width="12" height="12"/><rect x="86" y="38" width="12" height="12"/><rect x="22" y="72" width="12" height="12"/><rect x="38" y="88" width="12" height="12"/><rect x="72" y="72" width="12" height="12"/><rect x="88" y="88" width="12" height="12"/>',
  // Llamado a la acción
  contact:
    '<rect x="32" y="32" width="56" height="56" rx="26"/><circle cx="36" cy="36" r="17"/><circle cx="84" cy="36" r="17"/><circle cx="36" cy="84" r="17"/><circle cx="84" cy="84" r="17"/><path d="M40 40 80 80M80 40 40 80"/>',
};

const small: Record<string, string> = {
  arrow: '<path d="M1.5 8h12M9 3.5 13.5 8 9 12.5"/>',
  'arrow-left': '<path d="M14.5 8h-12M7 3.5 2.5 8 7 12.5"/>',
  plus: '<path d="M8 2v12M2 8h12"/>',
  close: '<path d="m3 3 10 10M13 3 3 13"/>',
  external: '<path d="M9 2h5v5M14 2 7.5 8.5"/><path d="M12 9.5V14H2V4h4.5"/>',
  search: '<circle cx="7" cy="7" r="4.6"/><path d="m10.4 10.4 3.8 3.8"/>',
};

const isService = name in service;
const body = isService ? service[name] : (small[name] ?? '');
---
<svg
  class={`icon ${isService ? 'icon--svc' : ''} ${cls}`}
  viewBox={isService ? '0 0 120 120' : '0 0 16 16'}
  fill="none"
  stroke="currentColor"
  stroke-width={isService ? 1.5 : 1.6}
  aria-hidden="true"
  set:html={body}
/>
