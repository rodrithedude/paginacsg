---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** Texto que se muestra sobre el marcador cuando todavía no hay foto. */
  label?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** Tono del marcador: claro (gris concreto) u oscuro. */
  tone?: 'light' | 'dark';
}

const {
  src,
  alt,
  label,
  widths = [480, 800, 1200],
  sizes = '(min-width: 760px) 50vw, 100vw',
  class: cls = '',
  loading = 'lazy',
  tone = 'light',
} = Astro.props;
---
{
  src ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={78}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : undefined}
      decoding="async"
      class={cls || undefined}
    />
  ) : (
    <div
      class={`ph ph--${tone} ${cls}`}
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
    >
      {label && <span class="ph__label">{label}</span>}
    </div>
  )
}
